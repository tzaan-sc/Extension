{
  "manifest_version": 3,
  "name": "Shadowing & Dictation",
  "version": "1.0.0",
  "description": "Luyện nghe, chép chính tả và shadowing trên YouTube với SidePanel thông minh",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://*.googlevideo.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["utils/subtitle_parser.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/injected.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "action": {
    "default_title": "Mở YouTube Shadowing & Dictation"
  }
}
